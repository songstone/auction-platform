# Manual-launch reference only. Spring Boot does not automatically load this file.
# bootRunLocal and scripts/run-backend.ps1 -WithInfrastructure start Compose and
# inject its actual connection values; no manual DB password is needed for them.
# The default bootstrap profile does not connect to external infrastructure.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# For manual connection to prepared infrastructure: SPRING_PROFILES_ACTIVE=local-infra
DB_URL=jdbc:postgresql://127.0.0.1:55432/auction
DB_USER=auction
# REQUIRED for manual local-infra launch: supply a runtime secret; never commit it.
# Managed local launch reads the preserved infra/.runtime/db-password automatically.
DB_PASSWORD=
# Optional local-infra connection/validation timeout overrides (milliseconds).
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
# Prepared for future adapters; no mail sender or photo storage adapter exists yet.
MAIL_HOST=127.0.0.1
MAIL_PORT=51025
# Root local runner supplies the absolute infra/.runtime/photos directory.
PHOTO_ROOT=
