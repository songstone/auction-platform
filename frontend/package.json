{
  "name": "auction-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "generate:contract": "node scripts/generate-contract.mjs",
    "check:generated": "node scripts/generate-contract.mjs --check",
    "typecheck": "npm run check:generated && tsc --noEmit",
    "test": "npm run check:generated && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
